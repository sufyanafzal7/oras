# ============================================================
# ORAS — root .gitignore
# Git is initialized at the oras/ folder root.
# ============================================================

# ---------- Python / ML (oras/ml) ----------
ml/venv/
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

# Datasets are tens of GB and not source code — never commit these.
# Document how to re-download/regenerate them instead.
ml/datasets/

# Training run outputs (weights, logs, plots) — large, regenerable.
ml/runs/

# ---------- Backend (oras/backend) ----------
backend/uploads/*
!backend/uploads/.gitkeep
backend/venv/
backend/__pycache__/
backend/instance/
backend/.env
*.db
*.sqlite3

# ---------- Flutter (oras/app) ----------
# app/.gitignore and app/android/.gitignore already cover most of
# this (auto-generated by `flutter create`) — duplicated here too
# in case git runs from root.
app/build/
app/.dart_tool/
app/.flutter-plugins
app/.flutter-plugins-dependencies
app/.packages
app/.pub-cache/
app/.pub/
app/**/ephemeral/

# ---------- IDE / editor ----------
.vscode/
.idea/
*.iml

# ---------- OS junk ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- Secrets — never commit these ----------
*.pem
*.key
.env
**/google-services.json
**/GoogleService-Info.plist

# ---------- ML model checkpoints ----------
# ml/models/tool_detection.onnx IS committed (small, needed for the
# backend to run). The root-level models/ folder below is NOT —
# see the deployment note in the README/chat before deploying:
# the backend needs models/phase/tcn_phase.onnx to exist wherever
# it runs, and this rule means a fresh clone won't have it.
/models/

# Flutter / Android build reports
app/android/build/

# ML outputs
ml/outputs/

# Large documentation artifacts (if regenerated)
folder_structure.txt

# App release builds (APKs, Windows installer, DLLs) — large binaries.
# Distribute these via GitHub Releases instead of committing them here.
releases/

# Stray/duplicate archives
app/lib.zip
*.zip



gradle-wrapper.jar
/.gradle
/.kotlin
/captures/
/gradlew
/gradlew.bat
/local.properties
GeneratedPluginRegistrant.java
.cxx/

# Remember to never publicly share your keystore.
# See https://flutter.dev/to/reference-keystore
key.properties
**/*.keystore
**/*.jks